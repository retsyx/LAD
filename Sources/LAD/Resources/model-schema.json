{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "message",
    "model",
    "assetIDs"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "message",
        "unsupported"
      ]
    },
    "message": {
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/model"
        },
        {
          "type": "null"
        }
      ]
    },
    "assetIDs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "units",
        "script",
        "reorganizePartIDs"
      ],
      "properties": {
        "reorganizePartIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "units": {
          "type": "string",
          "enum": [
            "mm"
          ]
        },
        "script": {
          "type": "string"
        }
      }
    }
  }
}
